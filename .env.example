# Copy to .env and fill in. Never commit .env.
# SQL Server sa password: at least 8 chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=
MSSQL_PID=Express
SQL_PORT=14333
WEB_PORT=8080

# AI providers (used from P1-T2; names only, no secret values here). See PLAN.md D11.
# Endpoint looks like https://<resource>.openai.azure.com (the app appends /openai/v1/)
AI__AzureOpenAI__Endpoint=
AI__AzureOpenAI__ApiKey=
AI__AzureOpenAI__ChatDeployment=gpt-5.4-mini
AI__AzureOpenAI__EmbeddingDeployment=text-embedding-3-small
AI__Ollama__Endpoint=
